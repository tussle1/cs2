    { "name": "Minesweeper", "short_name": "Mines", "url": "./?app=winmine", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Paint", "short_name": "Paint", "url": "./?app=paint", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] }
  ]
